# This is the base image used for Coder images. It's a multi-arch image that is
# built in depot.dev for all supported architectures. Since it's built on real
# hardware and not cross-compiled, it can have "RUN" commands.
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# We use a single RUN command to reduce the number of layers in the image.
# NOTE: Keep the Terraform version in sync with minTerraformVersion and
# maxTerraformVersion in provisioner/terraform/install.go.
RUN apk add --no-cache \
		curl \
		wget \
		bash \
		git \
		openssl \
		openssh-client \
		tzdata && \
	addgroup \
		-g 1000 \
		coder && \
	adduser \
		-D \
		-s /bin/bash \
		-h /home/coder \
		-u 1000 \
		-G coder \
		coder
# Terraform was disabled in the edge repo due to a build issue.
# https://gitlab.alpinelinux.org/alpine/aports/-/commit/f3e263d94cfac02d594bef83790c280e045eba35
# Using wget for now. Note that busybox unzip doesn't support streaming.
#
# The Terraform version and SHA256 come from terraform_SHA256SUMS, a copy of
# provisioner/terraform/terraform_SHA256SUMS (HashiCorp's GPG-signed checksum
# file). Every build context for this Dockerfile must include it. The build
# fails if there's no entry for this architecture or the download doesn't match.
COPY terraform_SHA256SUMS /tmp/terraform_SHA256SUMS
RUN ARCH="$(arch)"; if [ "${ARCH}" == "x86_64" ]; then ARCH="amd64"; elif [ "${ARCH}" == "aarch64" ]; then ARCH="arm64"; elif [ "${ARCH}" == "armv7l" ]; then ARCH="arm"; fi; cd /tmp && \
		ZIP="$(grep -oE "terraform_[0-9]+\.[0-9]+\.[0-9]+_linux_${ARCH}\.zip$" terraform_SHA256SUMS)" && \
		VERSION="$(echo "${ZIP}" | cut -d_ -f2)" && \
		wget "https://releases.hashicorp.com/terraform/${VERSION}/${ZIP}" && \
		grep -E "  ${ZIP}$" terraform_SHA256SUMS | sha256sum -c - && \
		busybox unzip "${ZIP}" -d /usr/local/bin && \
		rm -f "${ZIP}" terraform_SHA256SUMS && \
		chmod +x /usr/local/bin/terraform && \
		terraform --version
USER 1000:1000
ENV HOME=/home/coder
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt
WORKDIR /home/coder
