# This is the base image used for Coder images. It's a multi-arch image that is
# built in depot.dev for all supported architectures. Since it's built on real
# hardware and not cross-compiled, it can have "RUN" commands.
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# We use a single RUN command to reduce the number of layers in the image.
# NOTE: Keep the Terraform version in sync with minTerraformVersion and
# maxTerraformVersion in provisioner/terraform/install.go.
RUN apk add --no-cache \
		curl \
		wget \
		bash \
		git \
		openssl \
		openssh-client \
		tzdata && \
	addgroup \
		-g 1000 \
		coder && \
	adduser \
		-D \
		-s /bin/bash \
		-h /home/coder \
		-u 1000 \
		-G coder \
		coder
# Terraform was disabled in the edge repo due to a build issue.
# https://gitlab.alpinelinux.org/alpine/aports/-/commit/f3e263d94cfac02d594bef83790c280e045eba35
# Using wget for now. Note that busybox unzip doesn't support streaming.
#
# The SHA256 pins are for terraform_1.16.7_linux_*.zip, copied from HashiCorp's
# GPG-signed terraform_1.16.7_SHA256SUMS. Update them together with the
# version; the build fails if the download doesn't match.
RUN case "$(arch)" in \
		x86_64) ARCH="amd64" SHA256="5454efcf7fc87f0c2113111b9a5c7182f0ca1c6f0f23a1e110a50770a8fe473b" ;; \
		aarch64) ARCH="arm64" SHA256="2d6a3f1098de94f1672aaa4e6873ef91ade9eac38851d3a403e2009193208de4" ;; \
		armv7l) ARCH="arm" SHA256="4a0a478c5d62aa775d6136942f84f87c3557df01283c869ef2ceba2baa389510" ;; \
		*) echo "Unsupported architecture: $(arch)" >&2 && exit 1 ;; \
	esac && \
		wget -O /tmp/terraform.zip "https://releases.hashicorp.com/terraform/1.16.7/terraform_1.16.7_linux_${ARCH}.zip" && \
		echo "${SHA256}  /tmp/terraform.zip" | sha256sum -c - && \
		busybox unzip /tmp/terraform.zip -d /usr/local/bin && \
		rm -f /tmp/terraform.zip && \
		chmod +x /usr/local/bin/terraform && \
		terraform --version
USER 1000:1000
ENV HOME=/home/coder
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt
WORKDIR /home/coder
