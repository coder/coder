# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# fumadocs-mdx generated index
/.source

# generated docs content (synced from ../docs by scripts/sync-docs.mjs);
# keep the directory itself so fumadocs-mdx has a source dir on a clean checkout
/content/docs/*
!/content/docs/.gitkeep

# doc images copied into the bundle by the sync step
/public/images/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
