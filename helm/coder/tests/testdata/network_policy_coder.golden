---
# Source: coder/templates/networkpolicy.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: coder
  namespace: coder
  labels:
    helm.sh/chart: coder-0.1.0
    app.kubernetes.io/name: coder
    app.kubernetes.io/instance: release-name
    app.kubernetes.io/part-of: coder
    app.kubernetes.io/version: "0.1.0"
    app.kubernetes.io/managed-by: Helm
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: coder
      app.kubernetes.io/instance: release-name
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - ports:
        - port: http
          protocol: TCP
        - port: https
          protocol: TCP
      from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ingress-nginx
    # HA replicas reach each other for the embedded DERP relay (8080) and
    # NATS pubsub (6222). Neither port is configurable.
    - ports:
        - port: 8080
          protocol: TCP
        - port: 6222
          protocol: TCP
      from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: coder
              app.kubernetes.io/instance: release-name
    # Prometheus metrics, when CODER_PROMETHEUS_ENABLE is set in coder.env.
    - ports:
        - port: 2113
          protocol: TCP
      from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
    - ports:
      - port: 6060
        protocol: TCP
  egress:
    - ports:
        - port: 53
          protocol: UDP
        - port: 53
          protocol: TCP
    # HA replicas reach each other on the same fixed ports as the ingress rule.
    - ports:
        - port: 8080
          protocol: TCP
        - port: 6222
          protocol: TCP
      to:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: coder
              app.kubernetes.io/instance: release-name
    - ports:
        - port: 5432
          protocol: TCP
      to:
        - ipBlock:
            cidr: 10.0.0.5/32
    - ports:
      - port: 443
        protocol: TCP
---
# Source: coder/templates/coder.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  annotations: {}
  labels:
    app.kubernetes.io/instance: release-name
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: coder
    app.kubernetes.io/part-of: coder
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: coder-0.1.0
  name: coder
  namespace: coder
