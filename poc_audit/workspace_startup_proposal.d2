# Proposal: starting a workspace from the dogfood/coder template.
#
# Revision 1, derived verbatim from workspace_startup_asbuilt.d2 revision 6.
# Only the title and this header differ so far.
#
# RELATIONSHIP TO THE AS BUILT DIAGRAM
#
# This diagram is additive with respect to workspace_startup_asbuilt.d2.
# Lifelines, activations, messages, and notes may be added here. Nothing
# present in the as built diagram may be removed from this one: no lifeline,
# no activation bar, no message. Existing elements may be annotated, but the
# flow they describe stands, because it describes what the system actually
# does today.
#
# The as built diagram is frozen. Changes belong here.
#
# Message naming: each message is named for what the control flow means, not
# for its parameters and not by its internal API name.
#
# Label placement: messages use source-arrowhead labels so the text sits near
# the origin of the arrow rather than centred on it. Long labels are clamped
# back toward the centre by the layout engine.
#
# Scope:
#   - Success paths only. Anything that could fail is taken to succeed.
#   - Authentication and authorization are omitted, and assumed to succeed.
#   - No prebuilds. One workspace, created directly at the request of a user.
#   - No alternate paths.
#   - Wait and loop mechanics are omitted. provisionerd is already waiting for
#     work before the user acts, and returns to waiting afterward.
#   - No audit journal lifeline yet. Auditable events are expected to be
#     marked on the timelines here, mostly as notes on activation bars.
#
# Collapsed on purpose:
#   - All UI, CLI, and API flow is folded into the first user arrow.
#   - Pubsub and backup polling are reduced to one message.
#   - Terraform inspection commands are not shown.
#   - Dependency resolution during terraform init is not shown. Providers
#     resolve from the Terraform registry and are cached across builds via
#     TF_PLUGIN_CACHE_DIR; modules resolve from Coder registries and, in one
#     case, from Git. That is a supply chain concern rather than a control
#     flow one, and needs its own treatment.
#   - coder_script execution is a self message on the workspace_agent. That
#     one arrow stands for N concurrent OS processes, started together in an
#     errgroup, each with its own log file and timeout. The scripts come both
#     from the template directly, such as install-deps and
#     boundary_config_setup, and from Coder modules. Cron only scripts, such
#     as go-cache-cleanup-cron, are scheduled rather than run at startup, so
#     they are not part of this arrow at all.
#   - Terraform providers other than coder and docker are not shown.
#
# Terminology follows poc_audit/audit_approach.md: workspace_agent is always
# written in full and never shortened to "agent", since the bare word is
# reserved for the principal and agent sense.
#
# Auditable events carry the "auditable" class. d2 classes are purely visual,
# so the marking needs a legend to be self-explanatory. Which events are
# marked is a design choice still being made, so absence of the class means
# "not yet considered" rather than "decided not auditable".

classes: {
  auditable: {
    style: {
      stroke: "#B8860B"
      stroke-width: 3
      bold: true
      font-color: "#7A5C00"
      fill: "#FFF3C4"
    }
  }
}

startup: Workspace startup, proposal, dogfood/coder {
  shape: sequence_diagram

  user: User
  coderd: coderd
  db: Postgres
  pd: provisionerd
  tf: terraform CLI
  prov: terraform-provider-coder
  docker: Docker daemon
  ctr: workspace container
  agent: workspace_agent, dev
  dc: workspace_agent, coder (devcontainer)

  request: {
    user.req -> coderd.create: {
      source-arrowhead.label: create workspace
    }

    # Citation for the note below.
    #
    #   coderd/workspaces.go:724      ID: uuid.New()
    #   inside the InsertWorkspaceParams passed to db.InsertWorkspace on the
    #   preceding line, within the transaction opened at :646.
    #
    #   Line number valid at tree 26d5b2e2d21b8c77ab420a3dd04d78cf6a101dc9
    #   on branch tigre. The line itself was last written by commit
    #   118f12ac3abc7e0d607392654b6e85bcf0c8af8c, which is already reachable
    #   from origin/main, so the content citation is durable even though the
    #   line number is tied to this tree.
    #
    #   REMINDER: tigre is a prototype branch that will never merge. Before
    #   this diagram leaves prototype status, re-point this citation at a
    #   commit on main and re-check the line number, which will have moved.
    #
    # This diagram ignores the identifiers for the workspace build and the
    # provisioner job, which are minted in the same activation.
    coderd.create.identity: create workspace identity { class: auditable }

    coderd.create -> db.intent: {
      source-arrowhead.label: record build intent
    }
    coderd.create -> user.req: {
      source-arrowhead.label: accepted, build queued
    }
  }

  dispatch: {
    db.intent -> coderd.acquirer: {
      source-arrowhead.label: notify work available
    }
    coderd.acquirer -> pd.run: {
      source-arrowhead.label: dispatch build
    }
  }

  provision: {
    pd.run -> tf.init: {
      source-arrowhead.label: terraform init
    }
    pd.run -> tf.plan: {
      source-arrowhead.label: terraform plan
    }
    pd.run -> tf.apply: {
      source-arrowhead.label: terraform apply
    }
    tf.apply -> prov.mat: {
      source-arrowhead.label: materialize coder resources
    }
    tf.apply -> docker.create: {
      source-arrowhead.label: create infrastructure
    }
    docker.create -> ctr.boot: {
      source-arrowhead.label: start container
    }
  }

  ingest: {
    pd.run -> coderd.complete: {
      source-arrowhead.label: report build complete
    }
    coderd.complete -> db.result: {
      source-arrowhead.label: record build result
    }
  }

  runtime: {
    ctr.boot -> agent.up: {
      source-arrowhead.label: workspace_agent starts
    }
    agent.up -> coderd.agentreg: {
      source-arrowhead.label: register and fetch manifest
    }
    agent.up -> agent.up: {
      source-arrowhead.label: run coder_scripts
    }
    agent.up.note: Module payloads run here, not at plan time
    agent.up -> dc.up: {
      source-arrowhead.label: start devcontainer
    }
    dc.up -> coderd.subagentreg: {
      source-arrowhead.label: register child workspace_agent
    }
  }
}
