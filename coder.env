# Coder must be reachable from an external URL for users and workspaces to connect.
# e.g. https://coder.example.com
CODER_ACCESS_URL=

# Uncomment a line below only when you give it a value. An empty value
# replaces the built-in default, such as the 127.0.0.1:3000 HTTP listener.
# CODER_HTTP_ADDRESS=
CODER_PG_CONNECTION_URL=
# CODER_TLS_CERT_FILE=
# CODER_TLS_ENABLE=
# CODER_TLS_KEY_FILE=

# Run "coder server --help" for flag information.
