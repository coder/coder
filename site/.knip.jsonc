{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": ["./src/index.tsx", "./src/serviceWorker.ts"],
	"project": [
		"./src/**/*.ts",
		"./src/**/*.tsx",
		"./test/**/*.ts",
		"./e2e/**/*.ts"
	],
	"tags": ["-lintignore"],
	"ignore": ["**/*Generated.ts"],
	"ignoreBinaries": ["make", "protoc"],
	"ignoreDependencies": [
		"@tailwindcss/typography",
		"@types/react-virtualized-auto-sizer",
		"tailwindcss",
		"tw-animate-css",
		"ts-proto"
	]
}
