{
	"extends": "//",
	"files": {
		"includes": ["!e2e/**/*Generated.ts", "!scripts/*.mjs", "!src/vendor"]
	},
	"linter": {
		"rules": {
			"a11y": {
				"noAutofocus": "off", // oxlint owns no-autofocus
				"useIframeTitle": "off" // oxlint owns iframe-has-title
			}
		}
	},
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json"
}
