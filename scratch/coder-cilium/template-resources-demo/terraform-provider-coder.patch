@@ -0,0 +1,38 @@
+package provider
+
+import (
+	"context"
+
+	"github.com/hashicorp/terraform-plugin-sdk/v2/diag"
+	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
+
+	"github.com/coder/terraform-provider-coder/v2/provider/helpers"
+)
+
+const templateImportID = "import"
+
+func templateDataSource() *schema.Resource {
+	return &schema.Resource{
+		SchemaVersion: 1,
+		Description:   "Proposed POC data source for template identity in both provisioning scopes: Shared resources (once per template) and Per-workspace resources (each workspace).",
+		ReadContext: func(_ context.Context, rd *schema.ResourceData, _ interface{}) diag.Diagnostics {
+			if err := rd.Set("name", helpers.OptionalEnvOrDefault("CODER_WORKSPACE_TEMPLATE_NAME", "default")); err != nil {
+				return diag.FromErr(err)
+			}
+			rd.SetId(helpers.OptionalEnvOrDefault("CODER_WORKSPACE_TEMPLATE_ID", templateImportID))
+			return nil
+		},
+		Schema: map[string]*schema.Schema{
+			"id": {
+				Type:        schema.TypeString,
+				Computed:    true,
+				Description: "ID of the template, or `import` when unavailable during template import.",
+			},
+			"name": {
+				Type:        schema.TypeString,
+				Computed:    true,
+				Description: "Name of the template, or `default` when unavailable during template import.",
+			},
+		},
+	}
+}
diff --git a/provider/template_outputs.go b/provider/template_outputs.go
new file mode 100644
index 0000000..176a973
--- /dev/null
+++ b/provider/template_outputs.go
@@ -0,0 +1,90 @@
+package provider
+
+import (
+	"context"
+
+	"github.com/google/uuid"
+	"github.com/hashicorp/terraform-plugin-framework/datasource"
+	"github.com/hashicorp/terraform-plugin-framework/datasource/schema"
+	"github.com/hashicorp/terraform-plugin-framework/types"
+	"github.com/hashicorp/terraform-plugin-go/tftypes"
+	ctyjson "github.com/zclconf/go-cty/cty/json"
+
+	"github.com/coder/terraform-provider-coder/v2/provider/helpers"
+)
+
+type templateOutputsDataSource struct{}
+
+func (*templateOutputsDataSource) Metadata(_ context.Context, _ datasource.MetadataRequest, resp *datasource.MetadataResponse) {
+	resp.TypeName = "coder_template_outputs"
+}
+
+func (*templateOutputsDataSource) Schema(_ context.Context, _ datasource.SchemaRequest, resp *datasource.SchemaResponse) {
+	resp.Schema = schema.Schema{
+		Description: "Proposed POC data source for the immutable shared resource outputs snapshot supplied to a per-workspace build. Shared resources are provisioned once per template; per-workspace resources are provisioned for each workspace. Coder excludes sensitive outputs before supplying the snapshot. Build gating is enforced by the server.",
+		Attributes: map[string]schema.Attribute{
+			"id": schema.StringAttribute{
+				Computed:    true,
+				Description: "ID of the template, or `import` when unavailable during template import.",
+			},
+			"outputs": schema.DynamicAttribute{
+				Computed:    true,
+				Description: "Object containing non-sensitive shared resource output values, preserving nested objects, arrays, numbers, booleans, and nulls. Access values directly, for example `data.coder_template_outputs.current.outputs.namespace`. Defaults to an empty object during template import.",
+			},
+			"revision_id": schema.StringAttribute{
+				Computed:    true,
+				Description: "UUID of the shared resource revision supplying the snapshot, or an empty string when unavailable during template import.",
+			},
+		},
+	}
+}
+
+func (*templateOutputsDataSource) Read(ctx context.Context, _ datasource.ReadRequest, resp *datasource.ReadResponse) {
+	outputsJSON := helpers.OptionalEnvOrDefault("CODER_TEMPLATE_OUTPUTS", "{}")
+	// Use Terraform's JSON type inference, not Go's float64 decoding or SDK
+	// maps, to preserve heterogeneous tuples, nulls, and number precision.
+	impliedType, err := ctyjson.ImpliedType([]byte(outputsJSON))
+	if err != nil || !impliedType.IsObjectType() {
+		resp.Diagnostics.AddError("Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object", "")
+		return
+	}
+	typeJSON, err := ctyjson.MarshalType(impliedType)
+	if err != nil {
+		resp.Diagnostics.AddError("Unable to determine shared resource output types", "")
+		return
+	}
+	tfType, err := tftypes.ParseJSONType(typeJSON)
+	if err != nil {
+		resp.Diagnostics.AddError("Unable to determine shared resource output types", "")
+		return
+	}
+	tfValue, err := tftypes.ValueFromJSON([]byte(outputsJSON), tfType)
+	if err != nil {
+		// Decoder errors can include output values. Never expose the payload.
+		resp.Diagnostics.AddError("Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object", "")
+		return
+	}
+	outputs, err := types.DynamicType.ValueFromTerraform(ctx, tfValue)
+	if err != nil {
+		resp.Diagnostics.AddError("Unable to convert shared resource output values", "")
+		return
+	}
+
+	revisionID := helpers.OptionalEnv("CODER_TEMPLATE_RESOURCE_REVISION_ID")
+	if revisionID != "" {
+		if _, err := uuid.Parse(revisionID); err != nil {
+			resp.Diagnostics.AddError("Shared resource revision ID in CODER_TEMPLATE_RESOURCE_REVISION_ID must be a UUID", "")
+			return
+		}
+	}
+
+	resp.Diagnostics.Append(resp.State.Set(ctx, &struct {
+		ID         types.String  `tfsdk:"id"`
+		Outputs    types.Dynamic `tfsdk:"outputs"`
+		RevisionID types.String  `tfsdk:"revision_id"`
+	}{
+		ID:         types.StringValue(helpers.OptionalEnvOrDefault("CODER_WORKSPACE_TEMPLATE_ID", templateImportID)),
+		Outputs:    outputs.(types.Dynamic),
+		RevisionID: types.StringValue(revisionID),
+	})...)
+}
diff --git a/provider/template_outputs_protocol_test.go b/provider/template_outputs_protocol_test.go
new file mode 100644
index 0000000..b375ff8
--- /dev/null
+++ b/provider/template_outputs_protocol_test.go
@@ -0,0 +1,134 @@
+package provider_test
+
+import (
+	"os"
+	"testing"
+
+	"github.com/hashicorp/terraform-plugin-go/tfprotov5"
+	"github.com/hashicorp/terraform-plugin-go/tftypes"
+	"github.com/stretchr/testify/require"
+
+	"github.com/coder/terraform-provider-coder/v2/provider"
+)
+
+func TestTemplateOutputsProtocol(t *testing.T) {
+	server, err := provider.NewMux(t.Context())
+	require.NoError(t, err)
+	schemas, err := server.GetProviderSchema(t.Context(), &tfprotov5.GetProviderSchemaRequest{})
+	require.NoError(t, err)
+	require.Empty(t, schemas.Diagnostics)
+	require.Contains(t, schemas.ResourceSchemas, "coder_agent")
+	require.Contains(t, schemas.DataSourceSchemas, "coder_workspace")
+	sdk, err := provider.New().GRPCProvider().GetProviderSchema(t.Context(), &tfprotov5.GetProviderSchemaRequest{})
+	require.NoError(t, err)
+	require.Equal(t, sdk.Provider, schemas.Provider)
+	identity := schemas.DataSourceSchemas["coder_template"]
+	require.NotNil(t, identity)
+	require.Contains(t, identity.Block.Description, "Shared resources (once per template)")
+	require.Contains(t, identity.Block.Description, "Per-workspace resources (each workspace)")
+	sch := schemas.DataSourceSchemas["coder_template_outputs"]
+	require.NotNil(t, sch)
+	require.Contains(t, sch.Block.Description, "shared resource outputs snapshot")
+	require.Len(t, sch.Block.Attributes, 3)
+	for _, attr := range sch.Block.Attributes {
+		switch attr.Name {
+		case "outputs":
+			require.True(t, attr.Type.Is(tftypes.DynamicPseudoType))
+			require.True(t, attr.Computed)
+			require.Contains(t, attr.Description, "shared resource output values")
+		case "revision_id":
+			require.Contains(t, attr.Description, "shared resource revision")
+		}
+	}
+
+	for _, tc := range []struct {
+		name, outputs, revisionID, wantError string
+	}{
+		{name: "EmptyObject", outputs: "{}"},
+		{name: "EmptyEnvironment"},
+		{name: "MalformedJSON", outputs: `{"private-marker":`, wantError: "Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object"},
+		{name: "TrailingJSON", outputs: `{} {"private-marker":1}`, wantError: "Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object"},
+		{name: "Null", outputs: `null`, wantError: "Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object"},
+		{name: "Array", outputs: `[]`, wantError: "Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object"},
+		{name: "String", outputs: `"private-marker"`, wantError: "Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object"},
+		{name: "Number", outputs: `123`, wantError: "Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object"},
+		{name: "Boolean", outputs: `true`, wantError: "Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object"},
+		{name: "Whitespace", outputs: " \n", wantError: "Shared resource outputs in CODER_TEMPLATE_OUTPUTS must be a JSON object"},
+		{name: "InvalidRevision", outputs: "{}", revisionID: "private-marker", wantError: "Shared resource revision ID in CODER_TEMPLATE_RESOURCE_REVISION_ID must be a UUID"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("CODER_WORKSPACE_TEMPLATE_ID", "")
+			t.Setenv("CODER_TEMPLATE_OUTPUTS", tc.outputs)
+			t.Setenv("CODER_TEMPLATE_RESOURCE_REVISION_ID", tc.revisionID)
+			resp := readTemplateOutputs(t, server, sch)
+			if tc.wantError != "" {
+				require.Len(t, resp.Diagnostics, 1)
+				require.Equal(t, tfprotov5.DiagnosticSeverityError, resp.Diagnostics[0].Severity)
+				require.Equal(t, tc.wantError, resp.Diagnostics[0].Summary)
+				require.Empty(t, resp.Diagnostics[0].Detail)
+				require.NotContains(t, resp.Diagnostics[0].Summary, "private-marker")
+				return
+			}
+			values := templateOutputValues(t, resp, sch)
+			require.True(t, values["id"].Equal(tftypes.NewValue(tftypes.String, "import")))
+			require.True(t, values["revision_id"].Equal(tftypes.NewValue(tftypes.String, "")))
+			require.True(t, values["outputs"].Equal(tftypes.NewValue(tftypes.Object{AttributeTypes: map[string]tftypes.Type{}}, map[string]tftypes.Value{})))
+		})
+	}
+
+	t.Run("RefreshedSnapshots", func(t *testing.T) {
+		t.Setenv("CODER_WORKSPACE_TEMPLATE_ID", "11111111-1111-4111-8111-111111111111")
+		t.Setenv("CODER_TEMPLATE_RESOURCE_REVISION_ID", "22222222-2222-4222-8222-222222222222")
+		t.Setenv("CODER_TEMPLATE_OUTPUTS", `{"namespace":"first"}`)
+		first := templateOutputValues(t, readTemplateOutputs(t, server, sch), sch)
+		secondRevision := "33333333-3333-4333-8333-333333333333"
+		t.Setenv("CODER_TEMPLATE_RESOURCE_REVISION_ID", secondRevision)
+		// A subsequent shared resource revision can change output types and keys.
+		t.Setenv("CODER_TEMPLATE_OUTPUTS", `{"namespace":"second","new":true}`)
+		second := templateOutputValues(t, readTemplateOutputs(t, server, sch), sch)
+		require.True(t, first["id"].Equal(second["id"]))
+		require.True(t, second["revision_id"].Equal(tftypes.NewValue(tftypes.String, secondRevision)))
+		var outputs map[string]tftypes.Value
+		require.NoError(t, second["outputs"].As(&outputs))
+		require.True(t, outputs["namespace"].Equal(tftypes.NewValue(tftypes.String, "second")))
+		require.True(t, outputs["new"].Equal(tftypes.NewValue(tftypes.Bool, true)))
+		third := templateOutputValues(t, readTemplateOutputs(t, server, sch), sch)
+		require.True(t, second["outputs"].Equal(third["outputs"]))
+	})
+
+	t.Run("UnsetEnvironment", func(t *testing.T) {
+		for _, key := range []string{"CODER_WORKSPACE_TEMPLATE_ID", "CODER_TEMPLATE_OUTPUTS", "CODER_TEMPLATE_RESOURCE_REVISION_ID"} {
+			t.Setenv(key, "")
+			require.NoError(t, os.Unsetenv(key))
+		}
+		values := templateOutputValues(t, readTemplateOutputs(t, server, sch), sch)
+		require.True(t, values["id"].Equal(tftypes.NewValue(tftypes.String, "import")))
+		require.True(t, values["revision_id"].Equal(tftypes.NewValue(tftypes.String, "")))
+		var outputs map[string]tftypes.Value
+		require.NoError(t, values["outputs"].As(&outputs))
+		require.Empty(t, outputs)
+	})
+}
+
+func readTemplateOutputs(t *testing.T, server tfprotov5.ProviderServer, sch *tfprotov5.Schema) *tfprotov5.ReadDataSourceResponse {
+	t.Helper()
+	config, err := tfprotov5.NewDynamicValue(sch.ValueType(), tftypes.NewValue(sch.ValueType(), map[string]tftypes.Value{
+		"id":          tftypes.NewValue(tftypes.String, nil),
+		"revision_id": tftypes.NewValue(tftypes.String, nil),
+		"outputs":     tftypes.NewValue(tftypes.DynamicPseudoType, nil),
+	}))
+	require.NoError(t, err)
+	resp, err := server.ReadDataSource(t.Context(), &tfprotov5.ReadDataSourceRequest{TypeName: "coder_template_outputs", Config: &config})
+	require.NoError(t, err)
+	return resp
+}
+
+func templateOutputValues(t *testing.T, resp *tfprotov5.ReadDataSourceResponse, sch *tfprotov5.Schema) map[string]tftypes.Value {
+	t.Helper()
+	require.Empty(t, resp.Diagnostics)
+	value, err := resp.State.Unmarshal(sch.ValueType())
+	require.NoError(t, err)
+	var values map[string]tftypes.Value
+	require.NoError(t, value.As(&values))
+	return values
+}
